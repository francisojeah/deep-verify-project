# Server
APP_SERVER_LISTEN_PORT=3000
APP_SERVER_LISTEN_IP=0.0.0.0
APP_NAME=DeepVerify
APP_DESCRIPTION=DeepVerify API
API_VERSION=1

# MongoDB (Atlas free tier is fine). Required to boot.
DB_URI=mongodb+srv://user:password@cluster.mongodb.net/deep-verify

# Auth
JWT_SECRET=change-me
JWT_TIME=7d

# Detection service.
#   gradio -> the deployed Hugging Face Space
#   http   -> a self-hosted FastAPI instance of the same detector
ML_SERVICE_URL=https://francisojeah-deep-verify.hf.space
ML_SERVICE_MODE=gradio
ML_SERVICE_TIMEOUT_MS=90000

# URLs used in verification and password-reset emails
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:3000

# Mail
EMAIL_HOST=
EMAIL_USER=
EMAIL_PASSWORD=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
